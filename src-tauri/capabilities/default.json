{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Hermes desktop app",
  "local": true,
  "windows": ["hermes"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-download-and-install",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
