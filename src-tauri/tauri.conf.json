{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes WebUI Desktop",
  "version": "0.1.0",
  "identifier": "com.tuan3w.hermes-webui-desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "../hermes-webui/server.py": "server.py",
      "../hermes-webui/bootstrap.py": "bootstrap.py",
      "../hermes-webui/requirements.txt": "requirements.txt",
      "../hermes-webui/api": "api",
      "../hermes-webui/static": "static"
    }
  }
}
